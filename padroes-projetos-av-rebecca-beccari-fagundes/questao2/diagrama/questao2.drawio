        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam classAttributeIconSize 0\n\n&#39; Interfaces dos Produtos\ninterface DocumentoFiscal {\n    + emitir(): void\n}\ninterface Pagamento {\n    + processar(): void\n}\ninterface ComprovanteMatricula {\n    + gerar(): void\n}\n\n&#39; Produtos do Brasil\nclass Nfse implements DocumentoFiscal\nclass Pix implements Pagamento\nclass ComprovanteCpf implements ComprovanteMatricula\n\n&#39; Produtos do Chile\nclass BoletaElectronica implements DocumentoFiscal\nclass Webpay implements Pagamento\nclass ComprovanteRut implements ComprovanteMatricula\n\n&#39; Fábrica Abstrata\nabstract class MatriculaFactory {\n    + {abstract} criarDocumentoFiscal(): DocumentoFiscal\n    + {abstract} criarPagamento(): Pagamento\n    + {abstract} criarComprovante(): ComprovanteMatricula\n}\n\n&#39; Fábricas Concretas\nclass BrasilFactory extends MatriculaFactory {\n    + criarDocumentoFiscal(): DocumentoFiscal\n    + criarPagamento(): Pagamento\n    + criarComprovante(): ComprovanteMatricula\n}\n\nclass ChileFactory extends MatriculaFactory {\n    + criarDocumentoFiscal(): DocumentoFiscal\n    + criarPagamento(): Pagamento\n    + criarComprovante(): ComprovanteMatricula\n}\n\n&#39; Cliente\nclass Matricula {\n    - fabrica: MatriculaFactory\n    + Matricula(fabrica: MatriculaFactory)\n    + confirmarMatricula(): void\n}\n\nMatricula --&gt; MatriculaFactory : usa\nMatriculaFactory ..&gt; DocumentoFiscal : cria &gt;\nMatriculaFactory ..&gt; Pagamento : cria &gt;\nMatriculaFactory ..&gt; ComprovanteMatricula : cria &gt;\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="pCxPm60AEREDsWXZ-lg--1">
